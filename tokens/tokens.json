{
  "$meta": {
    "name": "Dabbleon Styles",
    "version": "0.1.0",
    "note": "Source of truth. Edit this file, then run `node scripts/build-tokens.mjs`. Never hand-edit web/tokens.css or apple/DesignTokens.swift."
  },
  "font": {
    "display": {
      "family": "Jost",
      "weight": 600,
      "stack": "\"Jost Variable\", \"Jost\", \"Avenir Next\", \"Century Gothic\", system-ui, sans-serif",
      "apple": "Jost",
      "role": "Headlines, empty states, marketing, onboarding, numerals in dashboards."
    },
    "ui": {
      "family": "Jost",
      "weight": 400,
      "stack": "\"Jost Variable\", \"Jost\", \"Avenir Next\", \"Century Gothic\", system-ui, sans-serif",
      "apple": "Jost",
      "role": "Buttons, labels, nav, form fields. See minSize \u2014 do not go below it."
    },
    "body": {
      "family": "Spectral",
      "weight": 400,
      "stack": "\"Spectral\", \"Iowan Old Style\", \"Palatino\", Georgia, serif",
      "apple": "Spectral",
      "role": "Paragraphs, articles, documentation, anything read for more than a sentence."
    },
    "mono": {
      "family": "JetBrains Mono",
      "weight": 400,
      "stack": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
      "apple": "SF Mono",
      "role": "Code, IDs, hashes, anything that needs fixed advance width."
    }
  },
  "typeScale": {
    "3xs": 11,
    "2xs": 12,
    "xs": 13,
    "sm": 14,
    "base": 16,
    "md": 18,
    "lg": 21,
    "xl": 24,
    "2xl": 30,
    "3xl": 36,
    "4xl": 48,
    "5xl": 60
  },
  "lineHeight": {
    "display": 1.1,
    "heading": 1.25,
    "ui": 1.45,
    "body": 1.65,
    "tight": 1.2
  },
  "letterSpacing": {
    "display": "-0.02em",
    "heading": "-0.01em",
    "normal": "0em",
    "eyebrow": "0.12em"
  },
  "space": {
    "0": 0,
    "1": 2,
    "2": 4,
    "3": 8,
    "4": 12,
    "5": 16,
    "6": 24,
    "7": 32,
    "8": 48,
    "9": 64,
    "10": 96
  },
  "radius": {
    "none": 0,
    "sm": 2,
    "md": 4,
    "lg": 8,
    "xl": 12,
    "full": 9999
  },
  "borderWidth": {
    "hairline": 1,
    "thick": 2
  },
  "color": {
    "neutral": {
      "0": "#FFFFFF",
      "50": "#FAFAF8",
      "100": "#F2F2EF",
      "200": "#E4E3DE",
      "300": "#CFCEC8",
      "400": "#A9A8A1",
      "500": "#78776F",
      "600": "#575650",
      "700": "#3D3C37",
      "800": "#272621",
      "900": "#181713",
      "950": "#0F0E0B"
    },
    "accent": {
      "50": "#FBF5EC",
      "100": "#F3E5D0",
      "200": "#E4C69C",
      "300": "#D2A567",
      "400": "#B9803A",
      "500": "#8C5921",
      "600": "#73481B",
      "700": "#5A3815",
      "800": "#402710",
      "900": "#2A1A0A"
    },
    "success": "#3F6F44",
    "warning": "#B9803A",
    "danger": "#9E3B2C",
    "info": "#3A5F7D",
    "accentLaser": {
      "50": "#FDF7F7",
      "100": "#F9E9E9",
      "200": "#F4D4D4",
      "300": "#E59999",
      "400": "#D75D5D",
      "500": "#BB2F2F",
      "600": "#A12828",
      "700": "#882222",
      "800": "#6D1B1B",
      "900": "#561515"
    },
    "pageGradient": {
      "from": "#F2F1F1",
      "to": "#DAD9D9"
    }
  },
  "semantic": {
    "light": {
      "bg": "color.neutral.0",
      "bgSubtle": "color.neutral.50",
      "bgMuted": "color.neutral.100",
      "surface": "color.neutral.0",
      "border": "color.neutral.200",
      "borderStrong": "color.neutral.300",
      "fgPrimary": "color.neutral.900",
      "fgSecondary": "color.neutral.600",
      "fgMuted": "color.neutral.500",
      "fgInverse": "color.neutral.0",
      "accent": "color.accent.500",
      "accentHover": "color.accent.600",
      "accentSubtle": "color.accent.50",
      "focusRing": "color.accent.400",
      "surfaceInverse": "color.neutral.950",
      "fgOnInverse": "color.neutral.0",
      "fgOnInverseMuted": "color.neutral.400",
      "borderOnInverse": "color.neutral.700",
      "bgGradientFrom": "color.pageGradient.from",
      "bgGradientTo": "color.pageGradient.to"
    },
    "dark": {
      "bg": "color.neutral.950",
      "bgSubtle": "color.neutral.900",
      "bgMuted": "color.neutral.800",
      "surface": "color.neutral.900",
      "border": "color.neutral.800",
      "borderStrong": "color.neutral.700",
      "fgPrimary": "color.neutral.100",
      "fgSecondary": "color.neutral.400",
      "fgMuted": "color.neutral.500",
      "fgInverse": "color.neutral.950",
      "accent": "color.accent.300",
      "accentHover": "color.accent.200",
      "accentSubtle": "color.accent.900",
      "focusRing": "color.accent.300",
      "surfaceInverse": "color.neutral.800",
      "fgOnInverse": "color.neutral.100",
      "fgOnInverseMuted": "color.neutral.400",
      "borderOnInverse": "color.neutral.600",
      "bgGradientFrom": "color.neutral.900",
      "bgGradientTo": "color.neutral.950"
    }
  },
  "constraints": {
    "uiFontMinSize": 13,
    "bodyMeasureCh": 68,
    "touchTargetMin": 44,
    "note": "uiFontMinSize exists because Jost is a geometric face with tall extenders and a modest x-height; below 13px its counters close up. If a design needs smaller UI text, that is a signal to change the design, not the token."
  },
  "motion": {
    "durationFast": 120,
    "durationBase": 200,
    "durationSlow": 320,
    "easeStandard": "cubic-bezier(0.2, 0, 0.1, 1)",
    "easeEnter": "cubic-bezier(0, 0, 0.1, 1)",
    "easeExit": "cubic-bezier(0.4, 0, 1, 1)"
  },
  "worlds": {
    "artist-laser": {
      "light": {
        "accent": "color.accentLaser.500",
        "accentHover": "color.accentLaser.600",
        "accentSubtle": "color.accentLaser.50",
        "focusRing": "color.accentLaser.400"
      },
      "dark": {
        "accent": "color.accentLaser.300",
        "accentHover": "color.accentLaser.200",
        "accentSubtle": "color.accentLaser.900",
        "focusRing": "color.accentLaser.300"
      }
    }
  }
}
